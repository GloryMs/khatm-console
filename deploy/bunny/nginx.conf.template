# Rendered at container start by the official nginx image (envsubst on /etc/nginx/templates).
# Only ${KHATM_API_HOST} and ${NGINX_RESOLVER} are substituted; nginx's own $vars are left alone.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Re-resolve the CDN host periodically instead of pinning the IP for the worker's lifetime
    # (the stale-upstream lesson from 2026-08-12).
    # Old Value: resolver ${NGINX_RESOLVER} valid=60s ipv6=off;
	resolver ${NGINX_LOCAL_RESOLVERS} valid=60s ipv6=off;
    resolver_timeout 5s;
    client_max_body_size 10m;

    location ~ ^/(api|\.well-known|t)/ {
        set $khatm_api https://${KHATM_API_HOST};
        proxy_pass $khatm_api;                      # variable form: full original URI is passed
        proxy_ssl_server_name on;
        proxy_ssl_name ${KHATM_API_HOST};
        proxy_set_header Host ${KHATM_API_HOST};   # bunny routes by Host — NOT $host
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-store" always;   # index.html must never be cached by the CDN
        try_files $uri $uri/ /index.html;
    }
}